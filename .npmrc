# Scoped registry mapping (example). Replace or set `ACME_TOKEN` in CI/env when needed.
@acme:registry=https://acme.com/
//acme.com/:_authToken=${ACME_TOKEN}

# Note: your provided registry pattern `https://acme.com/r/{name}.json` is not a standard npm registry URL pattern.
